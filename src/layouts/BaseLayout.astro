---
import tokensCss from "../styles/tokens.css?raw";
import globalCss from "../styles/global.css?raw";
import actsCss from "../styles/acts.css?raw";
import Analytics from "@vercel/analytics/astro";
import BrandMark from "../components/BrandMark.astro";
import DownloadButton from "../components/DownloadButton.astro";
import ThemeControl from "../components/ThemeControl.astro";
import { copy, facts } from "../data/site";
import { ogHeadline, ogImagePath, type Breadcrumb } from "../data/seo";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  markdownPath?: string;
  imagePath?: string;
  pageType?: "website" | "article";
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: Breadcrumb[];
  additionalSchema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = copy.title,
  description = copy.description,
  pageClass = "",
  markdownPath = "/index.md",
  imagePath,
  pageType = "website",
  datePublished,
  dateModified,
  breadcrumbs = [],
  additionalSchema = [],
  noindex = false,
} = Astro.props;
const repository = facts.repository;
const siteUrl = Astro.site ?? new URL("https://downright.cc/");
const siteRoot = siteUrl.toString().replace(/\/$/, "");
const normalizedPath = Astro.url.pathname === "/" ? "/" : `/${Astro.url.pathname.replace(/^\/+|\/+$/g, "")}/`;
const canonical = new URL(normalizedPath, siteUrl).toString();
const absolute = (path: string) => new URL(path, siteUrl).toString();
// Cards are generated per page from the same mirror path, so a page only needs
// to name an image when it wants to override the one built for it.
const imageUrl = absolute(imagePath ?? ogImagePath(markdownPath));
// Screen readers on X and Mastodon read this aloud, so it describes the card
// itself — its headline and its artwork — rather than restating the page title.
const imageAlt = `Downright card reading \u201C${ogHeadline(markdownPath, title)}\u201D, beside a Markdown file with one line added and one removed.`;
const organization = {
  "@type": "Organization",
  "@id": `${siteRoot}#organization`,
  name: "Downright",
  url: siteRoot,
  logo: absolute("/assets/downright-app-icon.png"),
  ...(repository ? { sameAs: [repository] } : {}),
};
const software = {
  "@type": "SoftwareApplication",
  "@id": `${siteRoot}#software`,
  name: "Downright",
  description: copy.description,
  url: siteRoot,
  operatingSystem: `macOS ${facts.minimumMacOS}+`,
  applicationCategory: "DeveloperApplication",
  isAccessibleForFree: true,
  downloadUrl: facts.downloadUrl || undefined,
  license: "MIT",
  softwareVersion: facts.version,
  publisher: { "@id": `${siteRoot}#organization` },
  ...(facts.downloadUrl ? { offers: { "@type": "Offer", price: "0", priceCurrency: "USD", url: facts.downloadUrl } } : {}),
};
const sourceCode = repository ? {
  "@type": "SoftwareSourceCode",
  "@id": `${siteRoot}#source`,
  name: "Downright source code",
  codeRepository: repository,
  programmingLanguage: "Swift",
  license: "https://opensource.org/license/mit/",
  isPartOf: { "@id": `${siteRoot}#software` },
} : null;
const webpage = {
  "@type": pageType === "article" ? ["Article", "WebPage"] : "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { "@id": `${siteRoot}#website` },
  about: { "@id": `${siteRoot}#software` },
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  ...(pageType === "article" ? { author: { "@id": `${siteRoot}#organization` }, image: imageUrl } : {}),
};
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumbs`,
  itemListElement: breadcrumbs.map((breadcrumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: breadcrumb.name,
    ...(breadcrumb.path ? { item: absolute(breadcrumb.path) } : {}),
  })),
} : null;
const schemaGraph = [
  organization,
  {
    "@type": "WebSite",
    "@id": `${siteRoot}#website`,
    name: "Downright",
    url: siteRoot,
    description: copy.description,
    publisher: { "@id": `${siteRoot}#organization` },
    inLanguage: "en-US",
  },
  software,
  sourceCode,
  webpage,
  breadcrumbSchema,
  ...additionalSchema,
].filter(Boolean);
const inlineStyles = `${tokensCss}\n${globalCss}\n${actsCss}`;
---

<!--
  ┌─────────────────────────────────────────────────────────────────────┐
  │  downright.cc — the living document                               │
  │                                                                     │
  │  One Markdown file runs this whole page. You can type in it,       │
  │ watch an agent rewrite it, win the conflict, spill a theme over     │
  │ it, flip it to this source, or drop your own .md on it.            │
  │                                                                     │
  │  No frameworks. One spring kernel, the app's own constants.        │
  │  Anonymous analytics, no cookies, no account. The document is the │
  │  site.                                                            │
  │                                                                     │
  │  This page is also Markdown:  curl downright.cc/index.md          │
  └─────────────────────────────────────────────────────────────────────┘
-->
<!doctype html>
<html lang="en" data-theme="warm-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="author" content="Downright" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#171614" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={absolute(markdownPath)} title="Markdown version" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin media="(min-width: 900px)" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Downright" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}
    {dateModified && <meta name="last-modified" content={dateModified} />}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph })}></script>
    <script is:inline>
      // Warm Dark is the house ground: every first visit lands on #171614.
      // A chosen theme persists and wins; "system" is one of the choices,
      // not the default. Runs before first paint so there is never a flash.
      (() => {
        try {
          const saved = localStorage.getItem("downright-theme");
          const theme = saved || "warm-dark";
          document.documentElement.dataset.theme = theme;
          const light = theme === "paper-light" || theme === "solarized-light" || theme === "high-contrast"
            || (theme === "system" && !window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.style.colorScheme = light ? "light" : "dark";
        } catch {}
      })();
    </script>
    <script is:inline>
      (() => {
        const activateFallbackFonts = () => {
          if (!document.fonts) return;
          Promise.all([
            document.fonts.load('400 1em "Newsreader"'),
            document.fonts.load('400 1em "Inter"'),
            document.fonts.load('400 1em "JetBrains Mono"'),
          ]).finally(() => document.documentElement.classList.add("fonts-ready"));
        };
        window.addEventListener("load", () => window.setTimeout(activateFallbackFonts, 2500), { once: true });
      })();
    </script>
    <Analytics />
    <style is:inline set:html={inlineStyles}></style>
  </head>
  <body class={pageClass} data-theme-zone>
    <header class="site-header" data-site-header data-theme-zone>
      <div class="site-header__inner">
        <BrandMark withDescriptor />
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/themes/">Themes</a>
          <a href="/guides/quick-look-markdown/">Guides</a>
          <a href="/changelog/">Changelog</a>
          {repository && <a href={repository} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
        </nav>
        <div class="site-header__actions">
          <button type="button" class="palette-trigger" data-palette-trigger data-magnet aria-label="Open the command palette (⌘K)">
            <span aria-hidden="true">⌘K</span>
          </button>
          <ThemeControl />
          <div class="header-download"><DownloadButton compact /></div>
        </div>
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span></span><span></span>
        </button>
      </div>
      <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden data-mobile-menu>
        <a href="/themes/">Themes</a>
        <a href="/guides/quick-look-markdown/">Guides</a>
        <a href="/changelog/">Changelog</a>
        {repository && <a href={repository} target="_blank" rel="noreferrer">GitHub</a>}
        <div class="mobile-menu__download"><small>Free · MIT · macOS {facts.minimumMacOS}+ — the download lives on your Mac: share this page to it below.</small></div>
      </nav>
    </header>

    <slot />

    <dialog class="command-palette glass" data-command-palette aria-label="Command palette">
      <div class="command-palette__header">
        <svg class="command-palette__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" data-palette-input placeholder="Search commands or jump to a section…" aria-label="Search commands" autocomplete="off" spellcheck="false" />
        <kbd class="command-palette__esc-badge" data-palette-close aria-hidden="true" title="Press Escape to close">esc</kbd>
      </div>
      <div class="command-palette__list" data-palette-list role="listbox"></div>
      <div class="command-palette__footer" aria-hidden="true">
        <div class="command-palette__hints">
          <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
          <span><kbd>↵</kbd> select</span>
          <span><kbd>esc</kbd> close</span>
        </div>
        <span class="command-palette__status" data-palette-status>Downright ⌘K</span>
      </div>
    </dialog>

    <dialog class="shortcut-sheet glass" data-shortcut-sheet aria-label="Keyboard shortcuts">
      <div class="shortcut-sheet__header">
        <div class="shortcut-sheet__title">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M8 16h8"/></svg>
          <strong>Keyboard shortcuts</strong>
        </div>
        <kbd class="shortcut-sheet__close-badge" data-shortcut-close aria-hidden="true" title="Press Escape to close">esc</kbd>
      </div>
      <table>
        <tbody>
          <tr><td><kbd>⌘K</kbd></td><td>Command palette</td></tr>
          <tr><td><kbd>⌘⇧E</kbd></td><td>Flip the window to its source</td></tr>
          <tr><td><kbd>Space</kbd></td><td>Quick Look the focused file card</td></tr>
          <tr><td><kbd>1–5</kbd></td><td>Structural zoom level</td></tr>
          <tr><td><kbd>← → ↑ ↓</kbd></td><td>Divider, zoom, rail, palette</td></tr>
          <tr><td><kbd>Esc</kbd></td><td>Close whatever opened</td></tr>
        </tbody>
      </table>
      <form method="dialog"><button type="submit">Done</button></form>
    </dialog>

    {!facts.downloadUrl && <div class="release-status glass" id="release-status" role="status" aria-live="polite" data-release-status>
      <div><strong>The signed macOS release is not configured yet.</strong><span>The download will start when a notarized artifact is verified at the release URL.</span></div>
      <button type="button" aria-label="Dismiss release status" data-release-dismiss>Close</button>
    </div>}

    <footer class="site-footer" data-theme-zone>
      <div class="site-footer__top">
        <BrandMark compact />
        <nav aria-label="Footer navigation">
          <span class="site-footer__group">
            <span class="site-footer__label">Product</span>
            {repository && <a href={repository} target="_blank" rel="noreferrer">Repository</a>}
            <a href="/changelog/">Changelog</a>
            {facts.sponsorsUrl && <a href={facts.sponsorsUrl} target="_blank" rel="noreferrer">Sponsor</a>}
            <a href="/themes/">Themes</a>
            <a href="/privacy/">Privacy</a>
            <span class="site-footer__license">{facts.license} licence</span>
          </span>
          <span class="site-footer__group">
            <span class="site-footer__label">Guides</span>
            <a href="/markdown-viewer-mac/">Markdown viewer</a>
            <a href="/markdown-editor-mac-free/">Free editors</a>
            <a href="/markdown-for-agents/claude-code/">Agent workflows</a>
            <a href="/downright-vs-typora/">Vs Typora</a>
            <a href="/downright-vs-obsidian/">Vs Obsidian</a>
            <a href="/faq/">FAQ</a>
          </span>
        </nav>
      </div>
      <p class="site-footer__absence">
        No cookies, no account, no newsletter, no chat widget. The app has no telemetry; this site uses anonymous, cookie-free analytics so we can see which pages help.
      </p>
      <div class="site-footer__bottom">
        <p>This page is also Markdown. <code>curl downright.cc/index.md | down</code></p>
        <div>
          <a href="/llms.txt">llms.txt</a>
          <a href="/humans.txt">humans.txt</a>
          <button type="button" data-sound-toggle>Sound: off</button>
          <button type="button" data-motion-toggle>Motion: full</button>
          <span>Free · MIT · macOS {facts.minimumMacOS}+</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      console.log("%cDownright%c This page is also Markdown: /index.md", "font-weight:700", "");
    </script>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
