---
import { benchmarks, facts } from "../data/site";

interface Props { reference?: boolean }
const { reference = false } = Astro.props;
const comparison = benchmarks.optimizations;
const sourceUrl = `${facts.repository}/blob/${benchmarks.sourceCommit}/${benchmarks.source}`;
---

<div class:list={[reference ? "answer-table-wrap" : "benchmark-table-wrap", "benchmark-comparison"]} tabindex="0" role="region" aria-label="Before-and-after benchmark comparisons; scroll horizontally for all columns">
  <table class={reference ? "answer-table" : "benchmark-table"} data-benchmark-comparison>
    <caption>Development-build comparisons · {comparison.date} · same Mac, same workload within each row</caption>
    <thead><tr><th scope="col">Measurement</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Reduction</th></tr></thead>
    <tbody>
      {comparison.rows.map((row) => <tr>
        <th scope="row">{row.measurement}<small>{row.statistic}</small></th>
        <td>{row.before}</td><td>{row.after}</td><td>{row.reduction}</td>
      </tr>)}
    </tbody>
  </table>
</div>
<p class="benchmark-comparison__context">{comparison.machine}. Recorded development builds; performance for the current download is not established by these comparisons. <a href={reference ? sourceUrl : "/benchmarks/#methodology"}>Test conditions and source</a>.</p>
