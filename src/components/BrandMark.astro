---
/**
 * Website lockup derived from the app icon's D and document rules. The app
 * tile is deliberately omitted: at navigation size the identity needs one
 * crisp silhouette, not a miniature rendering of the macOS icon.
 */

interface Props {
  compact?: boolean;
  href?: string;
  withWordmark?: boolean;
}
const { compact = false, href = "/", withWordmark = true } = Astro.props;
---
<a class:list={["brand", { "brand--compact": compact }]} href={href} aria-label="Downright home">
  <span class="brand-symbol" aria-hidden="true">
    <span class="brand-symbol__glow"></span>
    <span class="brand-symbol__shadow"></span>
    <svg class="brand-mark" viewBox="0 0 32 32" focusable="false">
      <rect class="brand-mark__spine" x="2" y="4" width="6" height="24" rx="3" />
      <path class="brand-mark__bowl" d="M11 4h7c7 0 12 5.2 12 12s-5 12-12 12h-7v-5h7c4.2 0 7-3 7-7s-2.8-7-7-7h-7V4Z" />
      <g class="brand-mark__rules">
        <rect class="brand-mark__rule brand-mark__rule--first" x="11" y="11" width="9" height="3" rx="1.5" />
        <rect class="brand-mark__rule brand-mark__rule--accent" x="11" y="15" width="9" height="3" rx="1.5" />
        <rect class="brand-mark__rule brand-mark__rule--last" x="11" y="19" width="9" height="3" rx="1.5" />
      </g>
    </svg>
  </span>
  {withWordmark && <span class="brand-wordmark"><span class="brand-wordmark__name">Downright</span></span>}
</a>
