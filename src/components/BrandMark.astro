---
/**
 * Interactive 3D Tactile Downright Brand Component
 * - Tactile cream paper squircle with deep debossed navy trenches
 * - Live mouse-tracking 3D tilt with a quiet spring return
 * - Dynamic theme-synchronized middle pill rule (matches --accent / --cta-fill)
 * - 2.5D layer parallax on pill rules and spring return physics
 */

interface Props {
  compact?: boolean;
  href?: string;
  withWordmark?: boolean;
  withDescriptor?: boolean;
}
const { compact = false, href = "/", withWordmark = true, withDescriptor = false } = Astro.props;
---
<a class:list={["brand", { "brand--compact": compact }]} href={href} aria-label="Downright home" data-brand-tilt>
  <span class="brand-symbol" aria-hidden="true">
    <span class="brand-symbol__shadow"></span>
    <!-- 3D Tilting Card Container -->
    <span class="brand-symbol__card">
      <svg class="brand-tile-svg" viewBox="0 0 32 32" fill="none" focusable="false">
        <defs>
          <!-- Squircle Face Gradient (Tactile Paper) -->
          <linearGradient id="bm-tile-face" x1="16" y1="0" x2="16" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#f8f5ee"/>
            <stop offset="100%" stop-color="#e3ded5"/>
          </linearGradient>
          <!-- Groove Inset Gradient -->
          <linearGradient id="bm-groove-face" x1="16" y1="4" x2="16" y2="28" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#0f1b28"/>
            <stop offset="100%" stop-color="#18283a"/>
          </linearGradient>
          <!-- Inner Trench Shadow -->
          <filter id="bm-groove-shadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="0.8" stdDeviation="0.4" flood-color="#050a10" flood-opacity="0.75"/>
          </filter>
          <!-- Pill Shadow -->
          <filter id="bm-pill-shadow" x="-25%" y="-25%" width="150%" height="150%">
            <feDropShadow dx="0" dy="0.5" stdDeviation="0.35" flood-color="#2a2520" flood-opacity="0.35"/>
          </filter>
        </defs>

        <!-- Base Squircle -->
        <rect width="32" height="32" rx="7.2" fill="url(#bm-tile-face)"/>
        <!-- Specular Bevel Rim -->
        <rect x="0.5" y="0.5" width="31" height="31" rx="6.7" stroke="#ffffff" stroke-opacity="0.95" stroke-width="0.9"/>
        <rect x="0.5" y="0.5" width="31" height="31" rx="6.7" stroke="#c4bcaf" stroke-opacity="0.35" stroke-width="0.9"/>

        <!-- Left Vertical Trench -->
        <g filter="url(#bm-groove-shadow)">
          <rect class="brand-trench brand-trench--spine" x="6" y="5.2" width="3.4" height="21.6" rx="1.7" fill="url(#bm-groove-face)"/>
          <rect x="6" y="5.2" width="3.4" height="21.6" rx="1.7" stroke="#000000" stroke-opacity="0.25" stroke-width="0.4"/>
        </g>

        <!-- Outer D Horseshoe Groove -->
        <g filter="url(#bm-groove-shadow)">
          <path class="brand-trench brand-trench--bowl" d="M11.4 5.2h5.6c5.5 0 9.2 3.6 9.2 10.8s-3.7 10.8-9.2 10.8h-5.6v-3.8h5.6c3.2 0 5.4-2.1 5.4-7s-2.2-7-5.4-7h-5.6V5.2Z" fill="url(#bm-groove-face)"/>
          <path d="M11.4 5.2h5.6c5.5 0 9.2 3.6 9.2 10.8s-3.7 10.8-9.2 10.8h-5.6v-3.8h5.6c3.2 0 5.4-2.1 5.4-7s-2.2-7-5.4-7h-5.6V5.2Z" stroke="#000000" stroke-opacity="0.25" stroke-width="0.4"/>
        </g>

        <!-- 3 Tactile Pill Rules on Cream Face -->
        <g class="brand-pills" filter="url(#bm-pill-shadow)">
          <!-- Top Pill -->
          <rect class="brand-pill brand-pill--first" x="11.6" y="10.8" width="8.2" height="2.5" rx="1.25" fill="#aba399"/>
          <rect x="12" y="11.1" width="7.4" height="0.8" rx="0.4" fill="#ffffff" fill-opacity="0.65"/>

          <!-- Middle Accent Pill (Synchronized with Theme Accent & Button Fill) -->
          <rect class="brand-pill brand-pill--accent" x="11.6" y="14.8" width="8.2" height="2.5" rx="1.25"/>
          <rect class="brand-pill-glow" x="12" y="15.1" width="7.4" height="0.8" rx="0.4" fill="#ffffff" fill-opacity="0.6"/>

          <!-- Bottom Pill -->
          <rect class="brand-pill brand-pill--last" x="11.6" y="18.8" width="8.2" height="2.5" rx="1.25" fill="#aba399"/>
          <rect x="12" y="19.1" width="7.4" height="0.8" rx="0.4" fill="#ffffff" fill-opacity="0.65"/>
        </g>
      </svg>
    </span>
  </span>
  {withWordmark && <span class="brand-wordmark">
    <span class="brand-wordmark__name">Downright</span>
    {withDescriptor && <span class="brand-wordmark__descriptor" aria-hidden="true">native / macOS</span>}
  </span>}
</a>
