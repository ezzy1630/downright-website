---
/**
 * The download CTA. The visible label stays singular; the surrounding page
 * owns the quieter platform and licensing details.
 */
import { facts } from "../data/site";

interface Props {
  compact?: boolean;
  label?: string;
}
const { compact = false, label = "Download for macOS" } = Astro.props;
const downloadUrl = import.meta.env.PUBLIC_DOWNLOAD_URL?.trim() || facts.downloadUrl;
const accessibleLabel = `${label}, ${facts.artifactName}, free, MIT licence`;
---

<a
  href={downloadUrl || "#"}
  download={downloadUrl ? facts.artifactName : undefined}
  rel="noreferrer"
  class:list={["button", "button--primary", "download-button", { "button--compact": compact }]}
  data-download
  data-download-url={downloadUrl}
  data-artifact={facts.artifactName}
  data-default-label={label}
  data-default-aria-label={accessibleLabel}
  data-magnet
  data-glow
  aria-disabled={downloadUrl ? undefined : "true"}
  aria-label={accessibleLabel}>
  <span class="download-button__progress" aria-hidden="true"></span>
  <span class="download-button__icon-wrap" aria-hidden="true">
    <svg class="download-button__icon download-button__icon--apple" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702"/>
    </svg>
    <svg class="download-button__icon download-button__icon--spinner" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <circle cx="12" cy="12" r="9" stroke-dasharray="28" stroke-dashoffset="14" />
    </svg>
    <svg class="download-button__icon download-button__icon--check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </span>
  <span class="download-button__label" data-download-label aria-live="polite">{label}</span>
</a>
