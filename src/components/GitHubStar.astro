---
import { facts } from "../data/site";

interface Props { placement: "hero" | "close" | "download" }
const { placement } = Astro.props;
---

{facts.repository && <a class="button button--quiet github-star" href={facts.repository} target="_blank" rel="noopener noreferrer" data-github-star={placement}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9Z" /></svg>
  <span>Star on GitHub</span>
</a>}
