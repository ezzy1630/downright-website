---
import { sampleMarkdown } from "../data/site";

const { mode = "plain", label = mode === "downright" ? "Downright" : "Plain preview" } = Astro.props;
const excerpt = sampleMarkdown.split("\n").slice(0, 18).join("\n");
---

<figure class:list={["preview-window", { "preview-window--downright": mode === "downright" }]}>
  <div class="preview-window__bar">
    <span class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="preview-window__title">{label}</span>
    <span class="preview-window__file">sample.md</span>
  </div>
  <div class="preview-window__body">
    {mode === "downright" ? (
      <div class="preview-rendered-copy">
        <h3>Downright renderer showcase</h3>
        <p><strong>Inline</strong> · <em>bold</em> · <code>code</code></p>
        <p><strong>Math</strong> · <span class="doc-math">e<sup>iπ</sup> + 1 = 0</span></p>
        <div class="preview-window__rule"></div>
        <p class="preview-callout"><span></span><b>Note</b> Native: prose + source + state + media.</p>
        <p class="preview-task"><span>✓</span> Code · math · Mermaid · table · task</p>
        <pre><code><span class="syntax-keyword">func</span> <span class="syntax-function">render</span>(source: <span class="syntax-type">String</span>)</code></pre>
      </div>
    ) : (
      <pre class="plain-preview"><code>{excerpt}</code></pre>
    )}
  </div>
</figure>
