---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  trail: string;
  updated: string;
  markdownPath: string;
  schema?: Record<string, unknown>;
}

const { title, trail, updated, markdownPath, schema } = Astro.props;
const pageTitle = title + " | Downright";
---

<BaseLayout title={pageTitle} markdownPath={markdownPath}>
  {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
  <main class="subpage legal-page answer-page">
    <section class="subpage-hero">
      <p class="subpage-hero__path">Downright / Guides / {trail}</p>
      <h1>{title}</h1>
      <p class="answer-meta">Updated {updated}</p>
    </section>
    <article class="legal-copy answer-copy">
      <slot />
    </article>
  </main>
</BaseLayout>
