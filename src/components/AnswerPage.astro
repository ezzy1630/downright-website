---
import BaseLayout from "../layouts/BaseLayout.astro";
import { imagePathForMarkdown, reviewedLabel, reviewedOn } from "../data/seo";

interface Props {
  title: string;
  trail: string;
  updated: string;
  markdownPath: string;
  description?: string;
  imagePath?: string;
  modifiedDate?: string;
  schema?: Record<string, unknown>;
}

const { title, trail, updated, markdownPath, description, imagePath = imagePathForMarkdown(markdownPath), modifiedDate = reviewedOn, schema } = Astro.props;
const pageTitle = title + " | Downright";
---

<BaseLayout
  title={pageTitle}
  description={description}
  markdownPath={markdownPath}
  imagePath={imagePath}
  pageType="article"
  dateModified={modifiedDate}
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Guides" }, { name: trail }]}
  additionalSchema={schema ? [schema] : undefined}
>
  <main class="subpage legal-page answer-page">
    <section class="subpage-hero">
      <p class="subpage-hero__path"><a href="/">Downright</a> / Guides / {trail}</p>
      <h1>{title}</h1>
      <p class="answer-meta">Reviewed {updated || reviewedLabel}</p>
    </section>
    <article class="legal-copy answer-copy">
      <slot />
    </article>
  </main>
</BaseLayout>
