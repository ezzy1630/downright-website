---
interface Props {
  src: string;
  alt: string;
  label: string;
  caption: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  label,
  caption,
  width,
  height,
  loading = "lazy",
} = Astro.props;
---

<figure class="native-capture">
  <div class="native-capture__frame">
    <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  </div>
  <figcaption><strong>{label}</strong><span>{caption}</span></figcaption>
</figure>
