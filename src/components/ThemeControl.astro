---
import { themes } from "../data/site";
---

<div class="theme-control" data-theme-control>
  <button class="theme-control__trigger" type="button" aria-expanded="false" aria-controls="theme-list" popovertarget="theme-list" popovertargetaction="toggle">
    <span class="theme-control__swatch" aria-hidden="true"></span>
    <span class="theme-control__label">Theme</span>
  </button>
  <div class="theme-panel glass" id="theme-list" popover="auto">
    <p class="theme-panel__title">Choose a theme</p>
    <div class="theme-panel__options" role="listbox" aria-label="Site theme">
      {themes.map((theme) => (
        <button type="button" role="option" aria-selected={theme.id === "warm-dark" ? "true" : "false"} data-theme-option={theme.id} popovertarget="theme-list" popovertargetaction="hide">
          <span class="theme-option__dot" style={`--dot: ${theme.palette.background}; --dot-ink: ${theme.palette.accent}`} aria-hidden="true"></span><span>{theme.name}</span>
        </button>
      ))}
    </div>
  </div>
</div>
