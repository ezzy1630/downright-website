---
/**
 * /themes — one live window, six real controls.
 *
 * The old page stacked six non-interactive screenshots of the same document,
 * which was long to scroll, impossible to use, and duplicated the switcher in
 * the header. There are no captures here now: the window below is the same
 * component the homepage uses, reading the same store, and every control
 * re-inks this page through the app's own spill engine.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import AppWindow from "../components/AppWindow.astro";
import { copy, themes, themeColorEntries } from "../data/site";
import { pageMeta, reviewedOn } from "../data/seo";
---

<BaseLayout
  {...pageMeta.themes}
  dateModified={reviewedOn}
>
  <main class="subpage themes-page" data-theme-zone>
    <section class="subpage-hero">
      <p class="eyebrow">Downright / Themes</p>
      <h1>{copy.themes.heading}</h1>
      <p>{copy.themes.body}</p>
    </section>

    <section class="themes-page__stage" aria-label="Theme picker and live document">
      <div class="themes-page__controls" role="listbox" aria-label="Choose a theme">
        {themes.map((theme) => (
          <button
            type="button"
            role="option"
            aria-selected={theme.id === "warm-dark" ? "true" : "false"}
            data-theme-option={theme.id}
            data-magnet
            data-pop
            data-glow
          >
            <span
              class="theme-option__dot"
              style={`--dot: ${theme.palette.background}; --dot-ink: ${theme.palette.accent}`}
              aria-hidden="true"
            ></span>
            <strong>{theme.name}</strong>
            <small>{theme.appearance}</small>
          </button>
        ))}
        <p class="themes-page__note">
          Type in the window. Switch themes while you type. Nothing here is a screenshot.
        </p>
      </div>

      <div class="themes-page__window" data-glow>
        <AppWindow editable view="split" label="sample.md" />
      </div>
    </section>

    <section class="theme-token-table" aria-label="Theme values">
      <p>The same values, straight from the app's theme files.</p>
      <div class="theme-token-table__rows">
        {themes.map((theme) => (
          <div>
            <strong>{theme.name}</strong>
            {themeColorEntries(theme).slice(0, 4).map(([, value]) => <code>{value}</code>)}
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
