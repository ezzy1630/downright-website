---
import BaseLayout from "../layouts/BaseLayout.astro";
import changelog from "../data/app/changelog.json";
import { facts } from "../data/site";
import { pageMeta, reviewedOn } from "../data/seo";
import ChangelogGroup from "../components/ChangelogGroup.astro";

type ChangelogEntry = (typeof changelog.entries)[number];
type ChangelogGroup = { version: string; date: ChangelogEntry["date"]; entries: ChangelogEntry[] };
const grouped: ChangelogGroup[] = [];
for (const entry of changelog.entries) {
  const existing = grouped.find((group) => group.version === entry.version);
  if (existing) existing.entries.push(entry);
  else grouped.push({ version: entry.version, date: entry.date, entries: [entry] });
}
// The newest releases stay open; the long tail folds so a phone isn't a
// thirty-screen scroll. Everything stays in the page for search and agents.
const RECENT_RELEASES = 3;
const recent = grouped.slice(0, RECENT_RELEASES);
const older = grouped.slice(RECENT_RELEASES);
---

<BaseLayout {...pageMeta.changelog} dateModified={reviewedOn}>
  <main class="subpage changelog-page">
    <section class="subpage-hero">
      <p class="subpage-hero__path">Downright / Changelog</p>
      <h1>Version truth, in public.</h1>
      <p>Every Downright release and what changed in it, newest first. Entries come straight from the app's CHANGELOG.md.</p>
      <a class="text-link" href="/changelog.xml">Subscribe to RSS <span aria-hidden="true">↗</span></a>
    </section>
    <section class="changelog-list">
      {recent.map((group) => <ChangelogGroup group={group} />)}
      {older.length > 0 && (
        <details class="changelog-older">
          <summary>Older releases <span>({older.length})</span></summary>
          {older.map((group) => <ChangelogGroup group={group} />)}
        </details>
      )}
    </section>
    <p class="source-stamp">Built from Downright commit {facts.sourceCommit.slice(0, 12)} on {new Date(facts.generatedAt).toISOString().slice(0, 10)}.</p>
  </main>
</BaseLayout>
