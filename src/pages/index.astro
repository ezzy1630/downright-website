---
import BaseLayout from "../layouts/BaseLayout.astro";
import DensityRail from "../components/DensityRail.astro";
import DownloadButton from "../components/DownloadButton.astro";
import AppWindow from "../components/AppWindow.astro";
import { benchmarks, brewCommand, copy, curlCommand, facts, npmCommand, themes } from "../data/site";
import { pageMeta, reviewedOn } from "../data/seo";

const benchmarkNames = ["Parse 100 KB", "Source edit and paragraph map", "Text diff, external rewrite", "End-to-end semantic convergence", "Syntax highlight, 10 KB Swift"];
const benchmarkRows = benchmarkNames
  .map((name) => benchmarks.rows.find((row) => row.measurement === name))
  .filter((row): row is NonNullable<typeof row> => Boolean(row));
const architectureClaims = [
  "Your text is the only source of truth",
  "One window for reading, editing, and source",
  "No WebView anywhere",
  "Downright never changes a byte of your file",
];
const annotations: [selector: string, label: string, detail: string][] = [
  [".doc-math--block", "Math", "Real symbols, typeset in the document."],
  [".mermaid-figure", "Diagrams", "Mermaid, drawn as part of the document."],
  [".doc-table", "Tables", "Pipe rows become a real table."],
  [".doc-callout", "Callouts", "GitHub alerts, drawn natively."],
  [".doc-footnote", "Footnotes", "Numbered and linked, at the bottom."],
  [".doc-code", "Code", "Syntax colours from the app's own themes."],
];
const maxBudgetMs = Math.max(...benchmarkRows.map((row) => parseFloat(row.target) || 8));
---

<BaseLayout {...pageMeta.home} dateModified={reviewedOn}>
  <main class="home-page" data-theme-zone>
    <DensityRail />

    {/* 8.1 — Hero: it's real, type in it */}
    <section class="hero section-anchor" id="hero" data-act="hero" data-rest="hero" data-rail-section data-section-label="Start" data-section-detail="The native Markdown app" data-theme-zone>
      <div class="hero__copy">
        <h1>{copy.hero.heading}</h1>
        <p>{copy.hero.body}</p>
        <div class="hero__actions">
          <DownloadButton />
          <div class="terminal-install" data-open="false">
            <button type="button" class="terminal-install__trigger" data-magnet aria-controls="terminal-install-menu" aria-expanded="false">
              <span class="terminal-install__prompt" aria-hidden="true">$</span>
              <span class="terminal-install__label">Install via Terminal</span>
              <span class="terminal-install__toggle" aria-hidden="true"></span>
            </button>
            <div id="terminal-install-menu" class="terminal-install__menu" role="group" aria-label="Terminal installation commands" aria-hidden="true" inert>
              <div class="terminal-install__menu-head" aria-hidden="true">
                <span>Choose an install path</span>
                <span>Click a command to copy</span>
              </div>
              <button type="button" class="terminal-install__option" data-install-command={brewCommand} aria-label="Copy Homebrew install command">
                <span class="terminal-install__method">Homebrew</span>
                <code>{brewCommand}</code>
                <span class="terminal-install__copy" data-install-label>Copy</span>
              </button>
              <button type="button" class="terminal-install__option" data-install-command={npmCommand} aria-label="Copy npm install command">
                <span class="terminal-install__method">npm</span>
                <code>{npmCommand}</code>
                <span class="terminal-install__copy" data-install-label>Copy</span>
              </button>
              <button type="button" class="terminal-install__option" data-install-command={curlCommand} aria-label="Copy curl install command">
                <span class="terminal-install__method">curl</span>
                <code>{curlCommand}</code>
                <span class="terminal-install__copy" data-install-label>Copy</span>
              </button>
            </div>
          </div>
        </div>
        <p class="hero__micro">{copy.hero.micro}</p>
      </div>
      <div class="hero__window" data-crop-ok>
        <AppWindow editable view="split" />
        <p class="hero__annotation">
          <svg class="hero__annotation-arrow" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
            <path d="M56 35C43 36 23 33 13 12" />
            <path d="M13 12l1.5 13.5M13 12l13.5 2" />
          </svg>
          <span>This window is real. Type in it.</span>
        </p>
        <div class="film-invite-row">
          <span class="film-invite" data-film-invite aria-hidden="true"></span>
          <button type="button" class="film-chip" data-film-type>Tap to type</button>
          <button type="button" class="film-chip" data-film-insert>Insert an edit</button>
        </div>
      </div>
    </section>

    {/* 8.2 — The gap, doubled */}
    <section class="gap-section section-anchor" id="gap" data-act="gap" data-rest="gap" data-band="0.5" data-rail-section data-section-label="The gap" data-section-detail="It opens badly" data-theme-zone>
      {/* The sweep: one pinned stage where the raw bytes become the page.
          Both halves of every block are live DOM from the same store. The
          stage owns its own scroll length so beat two never overlaps it. */}
      <div class="sweep-stage" data-sweep-stage>
      <div class="sweep" data-sweep>
        <p class="eyebrow">{copy.gap.eyebrow}</p>
        <p class="sweep__lede" data-sweep-lede>{copy.gap.lede}</p>
        <p class="sweep__closing" data-sweep-closing aria-hidden="true">{copy.gap.closing}</p>

        <ul class="annotation-rail" aria-label="What renders, as it renders">
          {annotations.map(([selector, label, detail]) => (
            <li data-annotation={selector}>
              <i class="annotation-rail__connector" aria-hidden="true"></i>
              <strong>{label}</strong>
              <span>{detail}</span>
            </li>
          ))}
        </ul>

        {/* The sweep's window IS the window — the same node the hero showed,
            re-parented into the pinned stage by the travel director. Its chrome
            morphs from macOS's plain Quick Look sheet to full Downright as the
            render line passes. The film builds its own simpler sheet inside
            this slot (travel is desktop-only). */}
        <div class="sweep__slot window-slot window-slot--gap" data-window-slot="gap"></div>

        <p class="sweep__capture">
          <span>{copy.gap.capture}</span>{" "}
        </p>
        <p class="sweep__annotation" data-sweep-annotation aria-hidden="true">{copy.gap.annotation}</p>
      </div>
      </div>

      <div class="gap-wall" data-fingerprint="agent-wall" aria-label="An agent's Markdown output">
        <h3 class="gap-wall__heading">{copy.gap.beatTwoHeading}</h3>
        <p class="gap-wall__line">{copy.gap.beatTwoLine}</p>
        <div class="gap-wall__scroller" data-agent-wall data-agent-wall-scroll tabindex="0" aria-label="Real agent-generated Markdown from a refactoring session"></div>
      </div>
    </section>

    {/* 8.5 — The agent visit: the climax */}
    <section class="page-section agent-section section-anchor" id="agent" data-act="agent" data-rest="agent" data-band="0.4" data-rail-section data-section-label="The agent visit" data-section-detail="Review the write" data-theme-zone>
      <div class="section-intro act-reveal">
        <h2>{copy.agent.heading}</h2>
        <p>{copy.agent.body}</p>
      </div>
      <div class="agent-stage" data-agent-stage>
        <div class="agent-stage__document" data-agent-document>
          <div class="window-slot window-slot--agent" data-window-slot="agent"></div>
        </div>
        <div class="conflict-bar" data-conflict-bar role="region" aria-label="External write needs review" hidden>
          <strong>An agent changed this file while you had it open.</strong>
          <button type="button" data-conflict-action="review" data-conflict-focus>Review</button>
          <button type="button" data-conflict-action="mine">Keep Mine</button>
          <button type="button" data-conflict-action="theirs">Take Theirs</button>
        </div>
        <div class="change-toast glass" data-change-toast role="status" aria-live="polite">
          <strong>External write</strong>
          <span data-change-summary>…</span>
        </div>
        <div class="review-panel" data-review-panel aria-hidden="true"></div>
      </div>
      <div class="agent-contextual" data-contextual-cta data-crop-ok hidden>
        <p>{copy.agent.contextual}</p>
        <DownloadButton />
      </div>
      <p class="agent-story act-reveal">
        Every change lands on a timeline, so you can compare any two versions later. Setup is three checkboxes and one default: <strong>nothing leaves your Mac</strong>.
      </p>
    </section>

    {/* 8.6 — Speed: dark band №1 */}
    <section class="dark-band speed-section section-anchor" id="speed" data-act="speed" data-rest="speed" data-band="0.3" data-rail-section data-section-label="Speed" data-section-detail="Budgets beside numbers" data-speed-section data-theme-zone>
      <div class="dark-band__inner">
        <div class="section-intro act-reveal">
          <h2>{copy.speed.heading}</h2>
          <p>{copy.speed.body}</p>
        </div>
        <div class="benchmark-table-wrap act-reveal">
          <table class="benchmark-table" data-fingerprint="benchmark">
            <caption>Current local benchmark · every row has its limit beside it</caption>
            <thead><tr><th scope="col">Measurement</th><th scope="col">p50</th><th scope="col">p95</th><th scope="col">Budget</th><th scope="col" aria-hidden="true"></th></tr></thead>
            <tbody>
              {benchmarkRows.map((row) => (
                <tr data-budget-row data-value={parseFloat(row.p50) || 0.15} data-scale={maxBudgetMs}>
                  <th scope="row">{row.measurement}</th>
                  <td>{row.p50}</td>
                  <td>{row.p95}</td>
                  <td>{row.target}</td>
                  <td class="benchmark-bar-cell" aria-hidden="true"><span class="benchmark-bar" data-budget-bar></span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="benchmark-session act-reveal" data-session-row>Your median parse this visit: waiting for a keystroke. Type in the living document and the measured result joins this table.</p>
        <div class="benchmark-notes act-reveal">
          <p><strong>Corpus</strong> {benchmarks.corpus}. <strong>Date</strong> {benchmarks.date}. <strong>Machine</strong> {benchmarks.machine}.</p>
          <p>{benchmarks.qualification} Missing: {benchmarks.limitations.join(", ")}.</p>
        </div>
      </div>
    </section>

    {/* 8.7 — Architecture: dark band №2 */}
    <section class="dark-band architecture-section section-anchor" id="architecture" data-act="architecture" data-rest="architecture" data-band="0.3" data-rail-section data-section-label="Architecture" data-section-detail="Raw text stays in charge" data-theme-zone>
      <div class="dark-band__inner architecture-layout" data-fingerprint="architecture">
        <div class="architecture-quote act-reveal">
          <p>{copy.architecture.heading}</p>
          <p class="architecture-quote__body">{copy.architecture.body}</p>
          <a href={facts.repository} target="_blank" rel="noreferrer">Read the repository <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="architecture-list act-reveal">{architectureClaims.map((claim) => <li>{claim}</li>)}</ul>
        <div class="architecture-mode act-reveal" role="tablist" aria-label="Read or source view">
          <span>One surface, two honest faces</span>
          <button type="button" role="tab" aria-selected="true" data-architecture-view="document">Document</button>
          <button type="button" role="tab" aria-selected="false" data-architecture-view="source">Source</button>
        </div>
        <p class="architecture-punctuation act-reveal">{copy.architecture.punctuation}</p>
      </div>
    </section>

    {/* 8.8 — System reach: verlet cards, Quick Look, terminal */}
    <section class="page-section reach-section section-anchor" id="reach" data-act="reach" data-rest="reach" data-band="0.3" data-rail-section data-section-label="System reach" data-section-detail="Finder, Quick Look, terminal" data-theme-zone>
      <div class="section-intro act-reveal">
        <h2>{copy.reach.heading}</h2>
        <p>{copy.reach.body}</p>
      </div>
      <div class="file-surface act-reveal" data-file-surface data-fingerprint="finder" aria-label="Markdown files — flick them, press Space to Quick Look, drag one onto the document">
        <div class="file-surface__bar">
          <span class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>Markdown</strong>
          <span>4 files · flick one, press Space to Quick Look</span>
        </div>
        <div class="file-surface__field" data-file-field></div>
      </div>
      <div class="quick-look" data-quick-look hidden>
        <div class="quick-look__panel" role="dialog" aria-modal="false" aria-label="Quick Look">
          <div class="quick-look__bar">
            <span class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <strong data-quick-look-title>file.md</strong>
            <button type="button" data-quick-look-close aria-label="Close Quick Look">Esc</button>
          </div>
          <div class="quick-look__body document-content" data-quick-look-body></div>
        </div>
      </div>
      <div class="terminal-artifact act-reveal" data-terminal data-fingerprint="terminal">
        <div class="terminal-artifact__bar"><span>down — the document from the terminal</span><span>zsh</span></div>
        <pre data-terminal-body><code></code></pre>
      </div>
    </section>

    {/* 8.9 — Themes: the spill */}
    <section class="page-section themes-section section-anchor" id="themes" data-act="themes" data-rest="themes" data-band="0.3" data-rail-section data-section-label="Themes" data-section-detail="Six palettes, one document" data-theme-zone>
      <div class="section-intro act-reveal">
        <h2>{copy.themes.heading}</h2>
        <p>{copy.themes.body}</p>
      </div>
      <div class="theme-showroom act-reveal">
        <div class="theme-showroom__list" data-fingerprint="themes" role="listbox" aria-label="Theme showroom">
          {themes.map((theme) => (
            <button type="button" role="option" aria-selected={theme.id === "warm-dark" ? "true" : "false"} data-theme-option={theme.id} data-magnet>
              <span class="theme-option__dot" style={`--dot: ${theme.palette.background}; --dot-ink: ${theme.palette.accent}`} aria-hidden="true"></span>
              <strong>{theme.name}</strong>
              <small>{theme.appearance}</small>
            </button>
          ))}
        </div>
        <div class="theme-showroom__document">
          <div class="window-slot window-slot--theme" data-window-slot="theme"></div>
        </div>
      </div>
    </section>

    {/* 8.10 — The close */}
    <section class="close-section section-anchor" id="close" data-act="close" data-rest="close" data-fingerprint="close" data-band="0.3" data-rail-section data-section-label="Free and open" data-section-detail="MIT, no account" data-theme-zone>
      <div class="close-section__inner act-reveal">
        <h2>{copy.close.heading}</h2>
        <p>{copy.close.body}</p>
        <DownloadButton />
        <small>macOS {facts.minimumMacOS}+ · signed {facts.artifactName} · {facts.version} · or <code>brew tap ezzy1630/downright &amp;&amp; brew trust --cask ezzy1630/downright/downright &amp;&amp; brew install --cask downright</code></small>
        <p class="close-sponsor" data-fingerprint="sponsor">Built by one person, funded by people, not telemetry. If Downright earns its place in your dock — <a href={facts.sponsorsUrl} target="_blank" rel="noreferrer">sponsor it</a>.</p>
        <div class="film-handoff" data-fingerprint="handoff" aria-label="Send this page to your Mac">
          <p class="film-handoff__line">Downright lives on your Mac. Send it there.</p>
          <button type="button" class="film-handoff__primary" data-share="share">AirDrop this page to your Mac</button>
          <div class="film-handoff__row">
            <button type="button" data-share="copy">Copy link</button>
            <button type="button" data-share="mail">Mail it to yourself</button>
            {facts.repository && <a href={facts.repository} target="_blank" rel="noreferrer">★ Star</a>}
            {facts.sponsorsUrl && <a href={facts.sponsorsUrl} target="_blank" rel="noreferrer">♥ Sponsor</a>}
          </div>
          <p class="film-handoff__note">No email, no server. On iPhone the first option in the share sheet is AirDrop.</p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const terminalInstall = document.querySelector(".terminal-install");
    const terminalTrigger = terminalInstall?.querySelector(".terminal-install__trigger");
    const terminalMenu = terminalInstall?.querySelector(".terminal-install__menu");
    if (terminalInstall && terminalTrigger && terminalMenu) {
      const setTerminalOpen = (open) => {
        if (open) {
          const spaceBelow = window.innerHeight - terminalTrigger.getBoundingClientRect().bottom;
          terminalInstall.dataset.menuPlacement = terminalMenu.offsetHeight + 16 > spaceBelow ? "above" : "below";
        }
        terminalInstall.dataset.open = String(open);
        terminalTrigger.setAttribute("aria-expanded", String(open));
        terminalMenu.setAttribute("aria-hidden", String(!open));
        terminalMenu.toggleAttribute("inert", !open);
      };
      terminalTrigger.addEventListener("click", () => setTerminalOpen(terminalInstall.dataset.open !== "true"));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && terminalInstall.dataset.open === "true") {
          setTerminalOpen(false);
          terminalTrigger.focus();
        }
      });
      let resetTimer;
      terminalMenu.querySelectorAll("[data-install-command]").forEach((option) => {
        const label = option.querySelector("[data-install-label]");
        if (!label) return;
        const defaultLabel = label.textContent?.trim() || "Copy";
        option.addEventListener("click", async () => {
          const command = option.dataset.installCommand;
          if (!command) return;
          if (!navigator.clipboard) {
            option.dataset.copyState = "unavailable";
            label.textContent = "Select command";
            return;
          }
          try {
            await navigator.clipboard.writeText(command);
            option.dataset.copyState = "copied";
            label.textContent = "Copied";
          } catch {
            option.dataset.copyState = "unavailable";
            label.textContent = "Try again";
          }
          if (resetTimer) window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            delete option.dataset.copyState;
            label.textContent = defaultLabel;
          }, 1800);
        });
      });
    }
  </script>
</BaseLayout>
